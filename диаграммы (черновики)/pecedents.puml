@startuml usecase
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #EEF5FF
  BorderColor #3A7BD5
}

actor "Гость" as Guest
actor "Зарегистрированный\nпользователь" as RegUser
actor "Администратор" as Admin
actor "Telegram API" as TG <<system>>
actor "VK API" as VK <<system>>
actor "LLM API" as LLM <<system>>

rectangle "Модуль агрегации объявлений" {
  usecase "Поиск объявлений" as UC1
  usecase "Просмотр результатов поиска" as UC2
  usecase "Просмотр карточки товара" as UC3
  usecase "Переход к оригинальному посту" as UC4
  usecase "Регистрация" as UC5
  usecase "Аутентификация" as UC6
  usecase "Сохранить в избранное" as UC7
  usecase "Управление избранным" as UC8
  usecase "Редактирование профиля" as UC9
  usecase "Выход из системы" as UC10
  usecase "Скрыть объявление" as UC11
  usecase "Восстановить объявление" as UC12
  usecase "Просмотр статистики" as UC13
  usecase "Мониторинг источников" as UC14
  usecase "Парсинг объявления через LLM" as UC15
  usecase "Сохранение объявления в БД" as UC16
  usecase "Загрузка фото в MinIO" as UC17
}

Guest --> UC1
Guest --> UC2
Guest --> UC3
Guest --> UC4
Guest --> UC5
Guest --> UC6

RegUser --> UC1
RegUser --> UC2
RegUser --> UC3
RegUser --> UC4
RegUser --> UC7
RegUser --> UC8
RegUser --> UC9
RegUser --> UC10

Admin --> UC11
Admin --> UC12
Admin --> UC13
Admin --> UC2
Admin --> UC3

UC14 --> TG : получает сообщения
UC14 --> VK : получает посты
UC14 ..> UC15 : <<include>>
UC15 --> LLM : запрос на парсинг
UC15 ..> UC16 : <<include>>
UC15 ..> UC17 : <<include>>
@enduml