@startuml infological
skinparam class {
  BackgroundColor #F0F8FF
  BorderColor #2E75B6
  ArrowColor #2E75B6
}

class "ПОЛЬЗОВАТЕЛЬ" as User {
  Идентификатор
  Электронная почта
  Хэш пароля
  ФИО
  Телефон
  Ссылка Telegram
  Ссылка ВКонтакте
  Роль
  Дата регистрации
}

class "ОБЪЯВЛЕНИЕ" as Listing {
  Идентификатор
  Оригинальный текст
  URL фотографии
  Бренд
  Модель
  Категория
  Размер
  Цвет
  Цена
  Город
  Состояние
  Ссылка на пост
  Дата публикации
  Скрыто (флаг)
}

class "ИСТОЧНИК" as Source {
  Идентификатор
  Платформа
  Внешний ID канала
  Название
  Активен (флаг)
  Дата добавления
}

class "ИЗБРАННОЕ" as Favorite {
  Идентификатор
  Дата сохранения
}

User "1" -- "0..*" Favorite : сохраняет >
Listing "1" -- "0..*" Favorite : < входит в
Source "1" -- "0..*" Listing : публикует >
@enduml